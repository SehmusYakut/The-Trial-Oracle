{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "env": {
    "K2_API_KEY": "@k2_api_key",
    "ENVIRONMENT": "production"
  },
  "buildCommand": null,
  "installCommand": "pip install -r requirements.txt"
}
